# InstagramScraper needs NO login credentials here — it reuses a persistent
# Chrome profile you log into manually once (see README Quickstart). Every
# variable below is optional.

# Optional — enables the geolocation enricher's 6th signal source (visual
# content recognition on post images) via Claude Vision. Without this the
# other geolocation signals (caption/hashtag/account/comment analysis) still
# run; this one is silently skipped. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional — enables English-language sentiment via Google Cloud Natural
# Language API in the NLP enrichment stage. Path to a GCP service-account
# JSON key with the Natural Language API enabled. Swahili/Sheng sentiment
# runs locally regardless (HuggingFace AfriSenti model) and doesn't need this.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional — enables pushing enriched output to a Supabase project.
# Get these from your Supabase project's Settings > API page.
SUPABASE_URL=
SUPABASE_KEY=
