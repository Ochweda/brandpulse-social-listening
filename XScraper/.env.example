# X (Twitter) login used by twikit for auth/session management only —
# actual tweet scraping goes through Playwright, not the twikit API.
# On first run these log in and cache the session to cookies.json;
# subsequent runs reuse cookies.json and don't need these again.
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# Optional — set only if X is unreachable on your network (VPN/proxy block).
# HTTPS_PROXY=http://host:port

# Optional — enables `python run_full_pipeline.py ... --supabase` / the
# --supabase flag to push enriched output to a Supabase project.
# Get these from your Supabase project's Settings > API page.
SUPABASE_URL=
SUPABASE_KEY=

# Optional — enables English-language sentiment via Google Cloud Natural
# Language API in the NLP enrichment stage. Path to a GCP service-account
# JSON key with the Natural Language API enabled. Swahili/Sheng sentiment
# runs locally regardless (HuggingFace AfriSenti model) and doesn't need this.
GOOGLE_APPLICATION_CREDENTIALS=
